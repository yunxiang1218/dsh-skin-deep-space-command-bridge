# Normalize text files to LF both in the repository and in the working tree.
# lib/client.js is generated by scripts/build.mjs and its SHA-256 is recorded in
# skin.build.json, so a CRLF conversion on checkout would break that record and
# the "committed bundle matches the sources" CI check.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.tgz binary
